[run]
source = fanficfare
omit =
    */tests/*
    */migrations/*
    */__pycache__/*
    */fanficfare/six.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

precision = 2
skip_empty = True

[html]
directory = htmlcov
